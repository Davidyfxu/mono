# 复制为 .env 后填写。该文件被 .gitignore 忽略，切勿提交。
# 密码请使用字母、数字和 - _ 等 URL 安全字符；若包含 @ : / 等字符，
# 写入 DATABASE_URL 时需要 URL 编码（例如 @ -> %40）。
MYSQL_DATABASE=taskboard
MYSQL_USER=taskboard
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
# 对外提供 Web 服务的端口（仅此端口需要放行防火墙）。
APP_PORT=80
TZ=Asia/Shanghai
